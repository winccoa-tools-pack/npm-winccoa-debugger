{
  "name": "@winccoa-tools-pack/winccoa-debug-adapter",
  "version": "0.1.0",
  "description": "Debug Adapter Protocol implementation for WinCC OA CTRL debugging",
  "author": "winccoa-tools-pack",
  "license": "proprietary",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapter": {
      "import": "./dist/esm/adapter/index.js",
      "require": "./dist/cjs/adapter/index.js",
      "types": "./dist/adapter/index.d.ts"
    },
    "./protocol": {
      "import": "./dist/esm/protocol/index.js",
      "require": "./dist/cjs/protocol/index.js",
      "types": "./dist/protocol/index.d.ts"
    },
    "./connection": {
      "import": "./dist/esm/connection/index.js",
      "require": "./dist/cjs/connection/index.js",
      "types": "./dist/connection/index.d.ts"
    }
  },
  "bin": {
    "winccoa-debug-adapter": "./dist/cjs/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:types": "tsc -p tsconfig.build.types.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:esm": "tsc -p tsconfig.build.esm.json && node scripts/fix-esm-imports.mjs",
    "build:bundle": "esbuild dist/cjs/cli.js --bundle --platform=node --format=cjs --external:winccoa-manager --outfile=dist/debugAdapter.js --log-level=info",
    "build": "npm run build:types && npm run build:cjs && npm run build:esm && npm run build:bundle",
    "compile": "tsc --build",
    "prepublishOnly": "npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "style-check": "npm run lint && npm run format:check && npm run lint:md",
    "style-fix": "npm run lint:fix && npm run format && npm run lint:md:fix",
    "test": "npm run style-check && npm run build && npm run test:unit",
    "test:unit": "node --import tsx scripts/run-node-tests.ts test/unit",
    "test:integration": "node --import tsx scripts/run-node-tests.ts test/integration",
    "ci:integration": "npm ci && npm run build && npm run test:integration"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "@winccoa-tools-pack/npm-winccoa-core": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.6.0",
    "markdownlint": "^0.40.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.59.1"
  },
  "config": {
    "winccoaImage": "mpokornyetm/winccoa-tools-pack-npm-winccoa-core:npm-winccoa-core"
  },
  "engines": {
    "node": ">=20"
  }
}
